# Convex Deployment URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# UniFi Access Configuration (Can also be set in Dashboard UI)
UNIFI_BASE_URL=https://192.168.1.1:12445
UNIFI_API_TOKEN=your_unifi_access_api_token
UNIFI_WEBHOOK_SECRET=your_optional_webhook_secret

# Jisr HR Open API Configuration (Can also be set in Dashboard UI)
# AWS: https://apis.jisr.net/api | Saudi Local: https://api.jisr.net.sa/api/
JISR_BASE_URL=https://apis.jisr.net/api
JISR_API_KEY=your_jisr_api_key
JISR_API_SECRET=your_jisr_api_secret
JISR_ACCESS_TOKEN=

# Operational Defaults
DEFAULT_TIMEZONE=Asia/Riyadh
